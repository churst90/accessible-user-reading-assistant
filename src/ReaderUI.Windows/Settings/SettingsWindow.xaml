<Window x:Class="Aura.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:Aura.UI.Settings"
        Title="Aura Settings"
        Width="780" Height="540"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AutomationProperties.Name="Aura Settings"
        FocusManager.FocusedElement="{Binding ElementName=CategoryList}">
  <Window.Resources>
    <Style TargetType="Label">
      <Setter Property="Margin" Value="0,8,8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style x:Key="HeadingStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" MinWidth="180" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ListBox x:Name="CategoryList"
             Grid.Row="0" Grid.Column="0"
             Margin="12"
             SelectedIndex="0"
             AutomationProperties.Name="Settings categories"
             SelectionChanged="CategoryList_SelectionChanged">
      <ListBoxItem Tag="{x:Static settings:SettingsCategory.General}">General</ListBoxItem>
      <ListBoxItem Tag="{x:Static settings:SettingsCategory.Speech}">Speech</ListBoxItem>
      <ListBoxItem Tag="{x:Static settings:SettingsCategory.Keyboard}">Keyboard</ListBoxItem>
      <ListBoxItem Tag="{x:Static settings:SettingsCategory.Keybindings}">Key bindings</ListBoxItem>
      <ListBoxItem Tag="{x:Static settings:SettingsCategory.ReviewCursor}">Review cursor</ListBoxItem>
      <ListBoxItem Tag="{x:Static settings:SettingsCategory.Braille}">Braille</ListBoxItem>
      <ListBoxItem Tag="{x:Static settings:SettingsCategory.Mouse}">Mouse</ListBoxItem>
    </ListBox>

    <Border Grid.Row="0" Grid.Column="1" Margin="0,12,12,12" Padding="20"
            BorderBrush="#22000000" BorderThickness="1" CornerRadius="2"
            AutomationProperties.Name="Settings details">
      <!-- Not a tab stop: an unnamed focusable host is the dead step that
           made Tab go silent before reaching the actual options. -->
      <ContentControl x:Name="DetailHost" Focusable="False" IsTabStop="False" />
    </Border>

    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,0,12,12">
      <Button x:Name="OkButton" IsDefault="True" Click="OkButton_Click">OK</Button>
      <Button x:Name="ApplyButton" Click="ApplyButton_Click">Apply</Button>
      <Button x:Name="CancelButton" IsCancel="True" Click="CancelButton_Click">Cancel</Button>
    </StackPanel>
  </Grid>
</Window>
