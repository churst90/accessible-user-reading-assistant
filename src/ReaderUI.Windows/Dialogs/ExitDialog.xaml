<Window x:Class="Aura.UI.Dialogs.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit Aura"
        Width="380" Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Exit Aura"
        FocusManager.FocusedElement="{Binding ElementName=YesButton}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0"
               Text="Are you sure you want to exit Aura?"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               FontSize="14" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="YesButton" IsDefault="True" MinWidth="80" Margin="0,0,8,0"
              AutomationProperties.Name="Yes, exit"
              Click="YesButton_Click">Yes</Button>
      <Button x:Name="NoButton" IsCancel="True" MinWidth="80"
              AutomationProperties.Name="No, keep running"
              Click="NoButton_Click">No</Button>
    </StackPanel>
  </Grid>
</Window>
