<Window x:Class="OpenReader.UI.Dialogs.SynthesizerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select synthesizer"
        Width="420" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Select synthesizer"
        FocusManager.FocusedElement="{Binding ElementName=EngineCombo}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Choose the speech engine OpenReader should use."
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <Label Content="Synthesizer:" Target="{Binding ElementName=EngineCombo}"
             AutomationProperties.LabeledBy="{Binding ElementName=EngineCombo}" />
      <ComboBox x:Name="EngineCombo"
                AutomationProperties.Name="Synthesizer"
                MinWidth="240" />
    </DockPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" IsDefault="True" MinWidth="80" Margin="0,0,8,0"
              AutomationProperties.Name="OK"
              Click="OkButton_Click">OK</Button>
      <Button x:Name="CancelButton" IsCancel="True" MinWidth="80"
              AutomationProperties.Name="Cancel"
              Click="CancelButton_Click">Cancel</Button>
    </StackPanel>
  </Grid>
</Window>
