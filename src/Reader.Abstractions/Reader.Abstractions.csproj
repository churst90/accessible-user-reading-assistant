<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Aura.Abstractions</RootNamespace>
    <AssemblyName>Aura.Abstractions</AssemblyName>
    <Description>Platform-neutral interfaces and value types. The contract every other project depends on.</Description>
  </PropertyGroup>

  <!-- NuGet metadata: this project is shipped to plugin authors as `Aura.Sdk`.
       The assembly name remains `Aura.Abstractions` so the host and plugins
       resolve to the same loaded type identity. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Aura.Sdk</PackageId>
    <Title>Aura Plugin SDK</Title>
    <PackageDescription>The contract for Aura app modules. Reference this package when writing a plugin: implement IAppModule, ship a manifest.json, and Aura will load you.</PackageDescription>
    <PackageTags>aura;screen-reader;accessibility;plugin;sdk</PackageTags>
    <PackageProjectUrl>https://github.com/Aura/Aura</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Aura/Aura</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <PackageReleaseNotes>Initial preview. API version 1.0. Contract surface: IAppModule, IAppContext, AppModuleManifest, ProcessInfo, IAccessibilityProvider, AccessibleNode, AccessibilityEvent, ISpeechEngine, SpeechRule, SpeechUtterance, IInputSource, RawInput.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
