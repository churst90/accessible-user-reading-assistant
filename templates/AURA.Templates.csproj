<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Aura.Templates</PackageId>
    <Title>Aura project templates</Title>
    <Description>dotnet new templates for Aura plugin development. Includes `aura-plugin` for scaffolding an app module.</Description>
    <PackageTags>dotnet-new;templates;aura;plugin</PackageTags>
    <PackageProjectUrl>https://github.com/Aura/Aura</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="aura-plugin\**\*"
             Exclude="aura-plugin\bin\**;aura-plugin\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
