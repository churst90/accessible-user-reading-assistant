<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>OpenReader.Templates</PackageId>
    <Title>OpenReader project templates</Title>
    <Description>dotnet new templates for OpenReader plugin development. Includes `openreader-plugin` for scaffolding an app module.</Description>
    <PackageTags>dotnet-new;templates;openreader;plugin</PackageTags>
    <PackageProjectUrl>https://github.com/OpenReader/OpenReader</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="openreader-plugin\**\*"
             Exclude="openreader-plugin\bin\**;openreader-plugin\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
